{
  "name": "1. Nova Chase — Lead Hunter",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "id": "ob001-0001-0001-0001-000000000001"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Find potential clients who need an AI chatbot for their website this week.",
        "options": {
          "systemMessage": "You are Nova Chase, Lead Generation Specialist at Obscuron Labs. Every Monday you find 10 potential businesses that would benefit from an AI chatbot. Search for: 1) Small-medium businesses in USA with websites but no chatbot (restaurants, real estate, law firms, clinics, salons, gyms) 2) Recent business openings or rebrands 3) Businesses complaining about customer service on social media 4) Fiverr buyers posting requests for chatbot services 5) Reddit/forums where business owners ask about AI tools. For each lead provide: business name, type, website if found, why they need a chatbot, and a suggested outreach message. Format as a clean numbered list. Sign as 'Nova Chase — Lead Hunter, Obscuron Labs'"
        }
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [500, 300],
      "id": "ob001-0001-0001-0001-000000000002"
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [400, 500],
      "id": "ob001-0001-0001-0001-000000000003"
    },
    {
      "parameters": {},
      "name": "SerpAPI",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [600, 500],
      "id": "ob001-0001-0001-0001-000000000004"
    },
    {
      "parameters": {
        "fromEmail": "barbaroscaptain70@gmail.com",
        "toEmail": "barbaroscaptain70@gmail.com",
        "subject": "🎯 Nova Chase — Weekly Lead Report",
        "emailFormat": "text",
        "message": "={{ $json.output }}",
        "options": {}
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [750, 300],
      "id": "ob001-0001-0001-0001-000000000005"
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
    "AI Agent": { "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]] },
    "OpenRouter Chat Model": { "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]] },
    "SerpAPI": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
