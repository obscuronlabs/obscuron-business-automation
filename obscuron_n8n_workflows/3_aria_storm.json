    {
      "parameters": {},
      "name": "SerpAPI",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [600, 500],
      "id": "ob003-0001-0001-0001-000000000004"
    },
    {
      "parameters": {
        "fromEmail": "barbaroscaptain70@gmail.com",
