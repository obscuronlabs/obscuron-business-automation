{
  "name": "Pery Ashcroft — Audience Psychology",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * */3"
            }
          ]
        }
      },
      "id": "node-schedule-5",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Research and prepare a listener behavior and audience psychology report for Neocomus Music.",
        "options": {
          "systemMessage": "You are Pery Ashcroft, Audience Psychology specialist at Neocomus Music. Every 3 days you prepare a listener behavior and audience psychology report. Analyze: 1) Current emotional trends in music consumption 2) Psychological triggers in successful music marketing 3) Audience engagement patterns on streaming platforms 4) How to position Olivia Oya Kaptan's multilingual music for maximum emotional impact 5) Fan loyalty and community building strategies 6) A/B testing recommendations for titles, covers, descriptions. Olivia sings in 8 languages, performing since 1995, jazz/blues/Latin/pop/soft rock. Sign as 'Pery Ashcroft — Audience Psychology Specialist, Neocomus Music'"
        }
      },
      "id": "node-agent-5",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-6",
        "options": {}
      },
      "id": "node-model-5",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        400,
        500
      ]
    },
    {
      "parameters": {},
      "id": "node-serp-5",
      "name": "SerpAPI",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [
        600,
        500
      ]
    },
    {
      "parameters": {
        "fromEmail": "neocomusmusic@gmail.com",
        "toEmail": "neocomusmusic@gmail.com",
        "subject": "🧠 Pery Ashcroft — Audience Psychology Report",
        "message": "={{ $json.output }}",
        "options": {},
        "emailFormat": "text"
      },
      "id": "node-email-5",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        750,
        300
      ]
    }
