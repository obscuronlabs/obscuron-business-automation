      "name": "SerpAPI",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [600, 500]
    },
    {
      "parameters": {
        "fromEmail": "neocomusmusic@gmail.com",
        "toEmail": "neocomusmusic@gmail.com",
        "subject": "💰 Atlas Reed — Streaming Revenue Report",
        "message": "={{ $json.output }}",
        "options": {}
      },
      "id": "node-email-2",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": {"main": [[{"node": "AI Agent","type": "main","index": 0}]]},
    "AI Agent": {"main": [[{"node": "Send Email","type": "main","index": 0}]]},
    "Anthropic Chat Model": {"ai_languageModel": [[{"node": "AI Agent","type": "ai_languageModel","index": 0}]]},
    "SerpAPI": {"ai_tool": [[{"node": "AI Agent","type": "ai_tool","index": 0}]]}
