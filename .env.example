# ─────────────────────────────────────────────────
# Obscuron Labs — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────

# ── AI Provider (choose one or both) ─────────────

# OpenAI (recommended for best results)
OPENAI_API_KEY=sk-...

# OpenRouter (cheaper alternative, same models)
OPENROUTER_API_KEY=sk-or-...
USE_OPENROUTER=false

# ── Lead Generation ───────────────────────────────

# SerpAPI key for search-based lead scraping
# Get one free at https://serpapi.com
SERPAPI_KEY=

# ── n8n Automation ────────────────────────────────

# Your n8n instance URL
N8N_WEBHOOK_URL=https://your-n8n.app/webhook/obscuron

# ── Discord Integration ───────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_REPORTS=
DISCORD_CHANNEL_LEADS=
DISCORD_CHANNEL_ALERTS=

# ── Output Settings ───────────────────────────────

OUTPUT_DIR=outputs
LOG_LEVEL=INFO
