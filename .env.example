# ─────────────────────────────────────────────────────────────────
# Obscuron Labs — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── AI Provider (choose one) ──────────────────────────────────────

# Option A: OpenAI direct
OPENAI_API_KEY=sk-...

# Option B: OpenRouter (cheaper, same models)
OPENROUTER_API_KEY=sk-or-...
USE_OPENROUTER=false

# ── Lead Generation ───────────────────────────────────────────────

# SerpAPI (optional — DuckDuckGo is used by default, no key needed)
# Get free key at https://serpapi.com
SERPAPI_KEY=

# ── n8n Automation ────────────────────────────────────────────────

N8N_WEBHOOK_URL=https://your-n8n.app/webhook/obscuron

# ── Discord Webhook URLs ──────────────────────────────────────────
# Create webhooks: Discord Server > Channel Settings > Integrations > Webhooks
# These are used by the Python pipeline to post rich embeds directly

DISCORD_WEBHOOK_REPORTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CLIENT_ANALYSIS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_OPERATIONS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_MARKET=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SALES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LEADS=https://discord.com/api/webhooks/...

# ── Discord Bot (used by n8n workflow) ────────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1507951917538476183

# ── Output Settings ───────────────────────────────────────────────

OUTPUT_DIR=outputs
LOG_LEVEL=INFO
